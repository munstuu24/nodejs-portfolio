<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <meta
    name="description"
    content="<%= profile.name %> - Developer Portfolio"
  >

  <title><%= profile.name %> | Portfolio</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  >

  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  >

  <link rel="stylesheet" href="/style.css">
</head>

<body>

  <!-- NAVIGATION -->

  <header class="navbar">
    <a href="#home" class="logo">
      <%= profile.initials %><span>.</span>
    </a>

    <nav id="navLinks" class="nav-links">
      <a href="#home">Home</a>
      <a href="#about">About</a>
      <a href="#skills">Skills</a>
      <a href="#projects">Projects</a>
      <a href="#contact" class="nav-contact">Let's Talk</a>
    </nav>

    <button
      class="menu-button"
      id="menuButton"
      aria-label="Toggle navigation"
      aria-expanded="false"
      aria-controls="navLinks"
    >
      ☰
    </button>
  </header>


  <!-- HERO SECTION -->

  <main>

    <section class="hero section-container" id="home">

      <div class="hero-content">

        <div class="availability">
          <span class="status-dot"></span>
          OPEN TO OPPORTUNITIES
        </div>

        <p class="hero-greeting">
          HELLO WORLD, I'M
        </p>

        <h1>
          <%= profile.name %><span class="blue">.</span>
        </h1>

        <h2>
          <%= profile.headline %>
        </h2>

        <p class="hero-description">
          <%= profile.introduction %>
        </p>

        <div class="hero-buttons">

          <a href="#projects" class="primary-button">
            Explore My Work ↗
          </a>

          <a href="#contact" class="secondary-button">
            Contact Me
          </a>

        </div>

        <div class="hero-bottom">
          <span>BASED IN <%= profile.location.toUpperCase() %></span>
          <span>SCROLL TO EXPLORE ↓</span>
        </div>

      </div>

      <div class="hero-art">
        <div class="art-circle circle-one"></div>
        <div class="art-circle circle-two"></div>

        <div class="code-card">
          <div class="card-dots">
            <i></i><i></i><i></i>
          </div>

          <div class="code-lines">
            <p><span>const</span> developer = {</p>
            <p class="indent">
              name: "<%= profile.name %>",
            </p>
            <p class="indent">
              passion: "Building",
            </p>
            <p class="indent">
              creativity: true,
            </p>
            <p>};</p>
          </div>
        </div>

        <div class="floating-label">
          &lt;/&gt; CREATE SOMETHING
        </div>
      </div>

    </section>


    <!-- ABOUT SECTION -->

    <section class="about section-container" id="about">

      <div class="section-heading">
        <span class="section-number">01 / ABOUT</span>
        <h2>A little about <span>me.</span></h2>
      </div>

      <div class="about-grid">

        <div class="about-visual">
          <div class="about-initials">
            <%= profile.initials %>
          </div>

          <div class="about-visual-footer">
            <span>CREATIVE THINKER</span>
            <span>DEVELOPER</span>
          </div>
        </div>

        <div class="about-text">

          <span class="eyebrow">WHO AM I?</span>

          <h3>
            Driven by curiosity.
            <br>
            Defined by creativity.
          </h3>

          <p><%= profile.about %></p>

          <p>
            My goal is to continuously improve as a developer,
            explore new technologies and create digital
            experiences that make an impact.
          </p>

          <div class="about-info">
            <div>
              <small>NAME</small>
              <strong><%= profile.name %></strong>
            </div>

            <div>
              <small>LOCATION</small>
              <strong><%= profile.location %></strong>
            </div>

            <div>
              <small>FOCUS</small>
              <strong><%= profile.title %></strong>
            </div>
          </div>

          <a href="#contact" class="text-link">
            Let's work together ↗
          </a>

        </div>

      </div>

    </section>


    <!-- SKILLS SECTION -->

    <section class="skills-section" id="skills">

      <div class="section-container">

        <div class="section-heading">
          <span class="section-number">02 / EXPERTISE</span>
          <h2>My creative <span>toolkit.</span></h2>

          <p>
            Technologies and tools I use to bring ideas to life.
          </p>
        </div>

        <div class="skills-grid">

          <% profile.skills.forEach((skill, index) => { %>

            <div class="skill-card">
              <span class="skill-index">
                <%= String(index + 1).padStart(2, "0") %>
              </span>

              <h3><%= skill %></h3>

              <span class="skill-arrow">↗</span>
            </div>

          <% }) %>

        </div>

      </div>

    </section>


    <!-- PROJECTS SECTION -->

    <section class="projects section-container" id="projects">

      <div class="section-heading">
        <span class="section-number">03 / SELECTED WORK</span>
        <h2>Things I've <span>built.</span></h2>

        <p>
          A selection of projects that showcase my skills
          and development journey.
        </p>
      </div>

      <div class="projects-grid">

        <% profile.projects.forEach(project => { %>

          <article class="project-card">

            <div class="project-visual">

              <span class="project-number">
                <%= project.number %>
              </span>

              <div class="project-symbol">
                &lt;/&gt;
              </div>

              <span class="project-category">
                <%= project.category %>
              </span>

            </div>

            <div class="project-information">

              <div class="project-title-row">
                <h3><%= project.title %></h3>

                <a
                  href="<%= project.link %>"
                  aria-label="View <%= project.title %>"
                >
                  ↗
                </a>
              </div>

              <p><%= project.description %></p>

              <div class="project-tags">

                <% project.technologies.forEach(tech => { %>
                  <span><%= tech %></span>
                <% }) %>

              </div>

            </div>

          </article>

        <% }) %>

      </div>

    </section>


    <!-- CONTACT SECTION -->

    <section class="contact-section" id="contact">

      <div class="section-container contact-content">

        <span class="section-number">
          04 / GET IN TOUCH
        </span>

        <h2>
          Have an idea?
          <br>
          <span>Let's make it happen.</span>
        </h2>

        <p>
          Whether it's a project, collaboration or just a
          conversation about technology, feel free to reach out.
        </p>

        <a
          class="contact-email"
          href="mailto:<%= profile.email %>"
        >
          <%= profile.email %> ↗
        </a>

        <div class="social-links">

          <a
            href="<%= profile.github %>"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub ↗
          </a>

          <a
            href="<%= profile.linkedin %>"
            target="_blank"
            rel="noopener noreferrer"
          >
            LinkedIn ↗
          </a>

        </div>

      </div>

    </section>

  </main>


  <!-- FOOTER -->

  <footer class="footer section-container">

    <a href="#home" class="logo">
      <%= profile.initials %><span>.</span>
    </a>

    <p>
      © <%= new Date().getFullYear() %>
      <%= profile.name %>. All rights reserved.
    </p>

    <a href="#home">BACK TO TOP ↑</a>

  </footer>


  <!-- MOBILE NAVIGATION -->

  <script>
    const menuButton = document.getElementById("menuButton");
    const navLinks = document.getElementById("navLinks");

    menuButton.addEventListener("click", () => {
      const isOpen = navLinks.classList.toggle("active");

      menuButton.setAttribute("aria-expanded", String(isOpen));
      menuButton.textContent = isOpen ? "✕" : "☰";
    });

    document.querySelectorAll(".nav-links a").forEach(link => {
      link.addEventListener("click", () => {
        navLinks.classList.remove("active");
        menuButton.setAttribute("aria-expanded", "false");
        menuButton.textContent = "☰";
      });
    });
  </script>

</body>
</html>